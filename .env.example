# URL canonique du site — sert au SEO, à l'Open Graph et au sitemap.
NEXT_PUBLIC_SITE_URL=https://maddev.dev

# --- Formulaire de contact (optionnel) -------------------------------------
# Sans RESEND_API_KEY, le formulaire fonctionne quand même : la demande est
# journalisée dans la console du serveur au lieu d'être envoyée par email.
# Clé à créer sur https://resend.com
RESEND_API_KEY=
# Adresse qui reçoit les demandes (par défaut : celle de content/site.ts)
CONTACT_TO_EMAIL=contact@maddev.dev
# Expéditeur — doit appartenir à un domaine vérifié chez Resend
CONTACT_FROM_EMAIL=MADDEV <contact@maddev.dev>
