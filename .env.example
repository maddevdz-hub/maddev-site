# URL canonique du site — sert au SEO, à l'Open Graph et au sitemap.
NEXT_PUBLIC_SITE_URL=https://maddev.dev

# --- Formulaire de contact (OBLIGATOIRE en production) ---------------------
# Sans RESEND_API_KEY, l'API répond 503 et le formulaire affiche « L'envoi a
# échoué » avec le renvoi vers WhatsApp. La demande est seulement écrite dans
# les journaux du serveur. Le site n'affiche jamais un faux « message reçu ».
# Clé à créer sur https://resend.com
RESEND_API_KEY=

# Adresse qui reçoit les demandes. Vide ou absente : maddev.dz@gmail.com
# (content/site.ts).
CONTACT_TO_EMAIL=maddev.dz@gmail.com

# Expéditeur. Doit appartenir à un domaine vérifié chez Resend (ici
# maddev.dev). Vide ou absente : « MADDEV <onboarding@resend.dev> », qui
# n'envoie QU'À l'adresse du compte Resend lui-même.
CONTACT_FROM_EMAIL=MADDEV <contact@maddev.dev>
